<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Client List</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="/admin/plugins/fontawesome-free/css/all.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="/admin/dist/css/adminlte.min.css">
  <style>
    .details-row { display: none; }
    .details-toggle { cursor: pointer; color: #007bff; text-decoration: underline; }
    .details-toggle:hover { text-decoration: none; }
  </style>
</head>
<body class="hold-transition dark-mode sidebar-mini layout-fixed layout-navbar-fixed layout-footer-fixed">
<div class="wrapper">
  <!-- Navbar -->
  <nav class="main-header navbar navbar-expand navbar-dark">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
      </li>
      <li class="nav-item d-none d-sm-inline-block">
        <a href="index3.html" class="nav-link">Home</a>
      </li>
      <li class="nav-item d-none d-sm-inline-block">
        <a href="#" class="nav-link">Contact</a>
      </li>
    </ul>

    <!-- Right navbar links -->
    <ul class="navbar-nav ml-auto">
      <!-- Navbar Search -->
      <li class="nav-item">
        <a class="nav-link" data-widget="navbar-search" href="#" role="button">
          <i class="fas fa-search"></i>
        </a>
        <div class="navbar-search-block">
          <form class="form-inline">
            <div class="input-group input-group-sm">
              <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search">
              <div class="input-group-append">
                <button class="btn btn-navbar" type="submit">
                  <i class="fas fa-search"></i>
                </button>
                <button class="btn btn-navbar" type="button" data-widget="navbar-search">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>
          </form>
        </div>
      </li>   
    </ul>
    <form action="/auth/logout" method="post">
        <button type="submit">Logout</button>
    </form>
  </nav>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="index3.html" class="brand-link">
      <img src="/admin/dist/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
      <span class="brand-text font-weight-light">Secure Transaction</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
      <!-- Sidebar user panel (optional) -->
      <div class="user-panel mt-3 pb-3 mb-3 d-flex">
        <div class="image">
          <img src=" " alt="User Photo" class="img-circle elevation-2" style="width: 50px; height: 50px;">

        </div>
        <div class="info">
            <a href="#" class="d-block"></a>
        </div>
    </div>
    
    
    
    

      <!-- SidebarSearch Form -->
 
      <!-- Sidebar Menu -->
 <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
          <li class="nav-item">
            <a href="/admin/dashboard" class="nav-link">
              <i class="nav-icon fas fa-table"></i>
              <p>Dashboard</p>
            </a>
          </li>
          <li class="nav-item">
            <a href="/user/transaction_list" class="nav-link">
              <i class="nav-icon fas fa-table"></i>
              <p>Recent Transaction</p>
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/client_list" class="nav-link">
              <i class="nav-icon fas fa-table"></i>
              <p>Client List</p>
            </a>
          </li>
        </ul>
      </nav>
     </div>
   </aside>

  <div class="content-wrapper">
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0">Client List</h1>
          </div>
        </div>
      </div>
    </div>
    
    <section class="content">
      <div class="container-fluid main-content">
        <div class="table-container">
          <table id="clientTable" border="1" width="100%" style="border-collapse: collapse;">
            <thead>
              <tr>
                <th>User ID</th>
                <th>Name</th>
                <th>Mobile Number</th>
                <th>National ID</th>
                <th>Email</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(user => { %>
                <tr class="user-row" data-user-id="<%= user.id %>">
                  <td><%= user.id %></td>
                  <td><%= user.username %></td>
                  <td><%= user.mobile_number %></td>
                  <td><%= user.national_id %></td>
                  <td><%= user.email_address %></td>
                  <td><span class="details-toggle">Show Transactions</span></td>
                </tr>
                <tr class="details-row" id="details-<%= user.id %>">
                  <td colspan="6">
                    <div>
                      <% if (userTransactionsMap[user.id]) { %>
                        <% userTransactionsMap[user.id].forEach(transaction => { %>
                          <div>
                            <strong>Type:</strong> <%= transaction.type %> | 
                            <strong>Amount:</strong> <%= transaction.amount %> | 
                            <strong>Date:</strong> <%= transaction.date %>
                          </div>
                        <% }) %>
                      <% } else { %>
                        No transactions available.
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <aside class="control-sidebar control-sidebar-dark">
  </aside>
</div>

<!-- Scripts -->
<script src="/admin/plugins/jquery/jquery.min.js"></script>
<script src="/admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/admin/dist/js/adminlte.js"></script>

<script>
$(document).ready(function() {
  // Handle row details toggle
  $('#clientTable').on('click', '.details-toggle', function() {
    const row = $(this).closest('tr');
    const userId = row.data('user-id');
    const detailsRow = $(`#details-${userId}`);

    if (detailsRow.is(':visible')) {
      detailsRow.hide();
      $(this).text('Show Transactions');
    } else {
      detailsRow.show();
      $(this).text('Hide Transactions');
    }
  });
});
</script>
</body>
</html>
